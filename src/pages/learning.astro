---
import PostCard from "@components/features/posts/PostCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { Icon } from "astro-icon/components";

const LEARNING_CATEGORY = "学习记录";
const learningPosts = (await getSortedPosts()).filter(
	(post) => post.data.category?.trim() === LEARNING_CATEGORY,
);

const latestDate = learningPosts.at(0)?.data.published;
const title = "学习专栏";
const description = "持续记录每天学到的知识、实践过程与阶段总结。";
---

<MainGridLayout title={title} description={description}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<section class="card-base mb-4 overflow-hidden rounded-(--radius-large)">
		<div class="flex items-center justify-between gap-5 px-6 py-6 md:px-9 md:py-7">
			<div class="flex min-w-0 items-center gap-4">
				<div
					class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white shadow-sm"
				>
					<Icon name="material-symbols:school-outline" class="text-3xl" />
				</div>
				<div class="min-w-0">
					<h1 class="text-2xl font-bold text-90 md:text-3xl">{title}</h1>
					<p class="mt-1 text-sm text-60 md:text-base">{description}</p>
				</div>
			</div>

			<div class="hidden shrink-0 items-center gap-7 text-right sm:flex">
				<div>
					<div class="text-2xl font-bold text-(--primary)">{learningPosts.length}</div>
					<div class="text-xs text-50">学习记录</div>
				</div>
				{
					latestDate && (
						<div>
							<div class="text-sm font-semibold text-80">
								{latestDate.toLocaleDateString("zh-CN", {
									year: "numeric",
									month: "2-digit",
									day: "2-digit",
								})}
							</div>
							<div class="mt-1 text-xs text-50">最近更新</div>
						</div>
					)
				}
			</div>
		</div>
	</section>

	{
		learningPosts.length > 0 ? (
			<div class="flex flex-col gap-4">
				{learningPosts.map((entry, index) => (
					<PostCard
						entry={entry}
						class="onload-animation"
						style={`--i: ${index}; --interval: 50ms;`}
					/>
				))}
			</div>
		) : (
			<section class="card-base rounded-(--radius-large) px-6 py-16 text-center">
				<Icon
					name="material-symbols:menu-book-outline-rounded"
					class="mx-auto mb-4 text-6xl text-(--primary) opacity-45"
				/>
				<h2 class="text-xl font-semibold text-80">还没有学习记录</h2>
				<p class="mt-2 text-sm text-50">第一条记录发布后会显示在这里。</p>
			</section>
		)
	}
</MainGridLayout>
