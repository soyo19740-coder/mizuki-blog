---
import { FilterTabs } from "@components/atoms/filter-tabs";
import PostCard from "@components/features/posts/PostCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { Icon } from "astro-icon/components";

const LEARNING_CATEGORY = "学习记录";
const learningPosts = (await getSortedPosts()).filter(
	(post) => post.data.category?.trim() === LEARNING_CATEGORY,
);

const defaultSections = ["LINUX学习", "GIT学习", "其他学习"];
const discoveredSections = learningPosts.map(
	(post) => post.data.learningSection?.trim() || "其他学习",
);
const sections = [...new Set([...defaultSections, ...discoveredSections])];
const filterTabs = [
	{
		value: "all",
		label: "全部",
		icon: "material-symbols:apps",
		count: learningPosts.length,
	},
	...sections.map((section) => ({
		value: section,
		label: section,
		count: learningPosts.filter(
			(post) => (post.data.learningSection?.trim() || "其他学习") === section,
		).length,
	})),
];

const latestDate = learningPosts.at(0)?.data.published;
const title = "学习专栏";
const description = "持续记录每天学到的知识、实践过程与阶段总结。";
const filterTabsScriptUrl = `${import.meta.env.BASE_URL}js/filter-tabs-handler.js`;
---

<MainGridLayout title={title} description={description}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<script is:inline src={filterTabsScriptUrl}></script>

	<section class="card-base mb-4 overflow-hidden rounded-(--radius-large)">
		<div class="flex items-center justify-between gap-5 px-6 py-6 md:px-9 md:py-7">
			<div class="flex min-w-0 items-center gap-4">
				<div
					class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white shadow-sm"
				>
					<Icon name="material-symbols:school-outline" class="text-3xl" />
				</div>
				<div class="min-w-0">
					<h1 class="text-2xl font-bold text-90 md:text-3xl">{title}</h1>
					<p class="mt-1 text-sm text-60 md:text-base">{description}</p>
				</div>
			</div>

			<div class="hidden shrink-0 items-center gap-7 text-right sm:flex">
				<div>
					<div class="text-2xl font-bold text-(--primary)">{learningPosts.length}</div>
					<div class="text-xs text-50">学习记录</div>
				</div>
				{
					latestDate && (
						<div>
							<div class="text-sm font-semibold text-80">
								{latestDate.toLocaleDateString("zh-CN", {
									year: "numeric",
									month: "2-digit",
									day: "2-digit",
								})}
							</div>
							<div class="mt-1 text-xs text-50">最近更新</div>
						</div>
					)
				}
			</div>
		</div>
		<div class="border-t border-black/5 px-6 py-4 dark:border-white/10 md:px-9">
			<FilterTabs
				tabs={filterTabs}
				dataAttr="learning-section"
				scopeId="learning-records"
			/>
		</div>
	</section>

	<div id="learning-records">
		{
			learningPosts.length > 0 ? (
			<div class="flex flex-col gap-4">
				{learningPosts.map((entry, index) => (
					<div
						class="learning-entry"
						data-learning-section={entry.data.learningSection?.trim() ||
							"其他学习"}
					>
						<PostCard
							entry={entry}
							class="onload-animation"
							style={`--i: ${index}; --interval: 50ms;`}
						/>
					</div>
				))}
			</div>
		) : (
			<section class="card-base rounded-(--radius-large) px-6 py-16 text-center">
				<Icon
					name="material-symbols:menu-book-outline-rounded"
					class="mx-auto mb-4 text-6xl text-(--primary) opacity-45"
				/>
				<h2 class="text-xl font-semibold text-80">还没有学习记录</h2>
				<p class="mt-2 text-sm text-50">第一条记录发布后会显示在这里。</p>
			</section>
		)
		}
		{
			learningPosts.length > 0 && (
				<div
					id="no-results"
					class="card-base hidden rounded-(--radius-large) px-6 py-16 text-center"
				>
					<Icon
						name="material-symbols:search-off-rounded"
						class="mx-auto mb-4 text-6xl text-(--primary) opacity-45"
					/>
					<h2 class="text-xl font-semibold text-80">
						该分区还没有学习记录
					</h2>
				</div>
			)
		}
	</div>
</MainGridLayout>

<style>
	.learning-entry.filtered-out {
		display: none;
	}
</style>
